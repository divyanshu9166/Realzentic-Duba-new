# Isolated local database for manual testing. Never point this at production.
# Keep your existing local host, user, and password; change only the database name.
DATABASE_URL=postgresql://<local-user>:<local-password>@localhost:5432/realzentic_dubai_test
# Optional explicit override used by Vitest. It must still name a *_test database.
TEST_DATABASE_URL=postgresql://<local-user>:<local-password>@localhost:5432/realzentic_dubai_test
SEED_ADMIN_PASSWORD=TestOnly2026!
SEED_STAFF_PASSWORD=StaffTest2026!
